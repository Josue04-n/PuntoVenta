@page "/facturas"
@using Blazor.Models
@using Blazor.Services
@using Blazor.Helpers
@using Application.DTOs.Common
@using Domain.Entities
@inject PosApiService ApiService
@inject IJSRuntime JS
@inject NavigationManager NavManager
@implements IDisposable

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<div class="uta-page d-print-none">
    <div class="uta-page-header">
        <div class="uta-page-header__left">
            <div class="uta-breadcrumb">
                <span style="cursor:pointer" @onclick='() => NavManager.NavigateTo("/")'>Panel Principal</span>
                <span class="uta-breadcrumb__sep">›</span>
                <span class="uta-breadcrumb__active">Historial de Facturas</span>
            </div>
            <h1 class="uta-page-title">
                <i class="bi bi-journal-text text-warning uta-page-title__icon"></i>
                Gestión de Facturas
            </h1>
            <p class="uta-page-subtitle">Consulta, reimpresión y revisión de comprobantes emitidos</p>
        </div>
        <div class="uta-page-header__right">
            <button class="uta-btn uta-btn--primary" @onclick='() => NavManager.NavigateTo("/ventas")'>
                <i class="bi bi-cart-plus"></i> &nbsp;Nueva Venta
            </button>
        </div>
    </div>

    <div class="uta-card">
        <div class="uta-card__header">
            <div class="uta-card__header-left">
                <i class="bi bi-search uta-card__header-icon"></i>
                Buscador de Comprobantes
            </div>
        </div>
        <div class="uta-card__body">
            <div class="uta-search-bar" style="max-width: 800px; margin: 0 auto 1.5rem auto;">
                <select class="uta-search-bar__select" @bind="_searchCriterion" @bind:after="OnSearchCriteriaChanged">
                    <option value="number">N° de Factura</option>
                    <option value="customer">Apellido del Cliente</option>
                </select>
                <input class="uta-search-bar__input" 
                       type="text" 
                       value="@_searchTerm" 
                       @oninput="OnInputSearch" 
                       placeholder="Buscar por N° de Factura o Apellido de Cliente..." />
                <div class="uta-search-bar__icon-container px-3 d-flex align-items-center bg-light">
                    <i class="bi bi-search text-muted"></i>
                </div>
            </div>

            <div class="uta-table-wrap uta-table-wrap--bordered">
                <table class="uta-table">
                    <thead>
                        <tr>
                            <th style="width: 140px;">N° Factura</th>
                            <th>Fecha Emisión</th>
                            <th>Cliente</th>
                            <th style="text-align:right;">Subtotal</th>
                            <th style="text-align:right;">IVA</th>
                            <th style="text-align:right;">Total</th>
                            <th style="text-align:center;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_pagedSalesResponse?.Items == null || !_pagedSalesResponse.Items.Any())
                        {
                            <tr>
                                <td colspan="7" class="uta-table__empty">
                                    <div class="uta-empty-state">
                                        <div class="uta-empty-state__icon"><i class="bi bi-file-earmark-x"></i></div>
                                        <div class="uta-empty-state__text">No hay facturas cargadas</div>
                                        <div class="uta-empty-state__sub">Utilice el buscador para encontrar comprobantes</div>
                                    </div>
                                </td>
                            </tr>
                        }
                        @foreach (var f in _pagedSalesResponse?.Items ?? Enumerable.Empty<SaleResponseDto>())
                        {
                            <tr>
                                <td><span class="uta-code-badge text-custom-primary">@f.InvoiceNumber</span></td>
                                <td style="color:#666">@FormatDate(f.IssueDate)</td>
                                <td class="uta-table__bold">@ReorderName(f.CustomerName)</td>
                                <td style="text-align:right; color:#666">$ @f.SubTotal.ToString("N2")</td>
                                <td style="text-align:right; color:#666">$ @f.VatAmount.ToString("N2")</td>
                                <td style="text-align:right; font-weight:700; color:#1a1a1a">$ @f.Total.ToString("N2")</td>
                                <td style="text-align:center;">
                                    <div style="display: flex; gap: 0.5rem; justify-content: center;">
                                        <button class="uta-btn uta-btn--sm uta-btn--outline" title="Ver Detalles en pantalla" @onclick="() => ViewDetail(f)">
                                            <i class="bi bi-eye"></i> Visualizar
                                        </button>
                                        <button class="uta-btn uta-btn--sm uta-btn--success" title="Descargar archivo PDF" @onclick="() => DownloadDirect(f)">
                                            <i class="bi bi-download"></i> Descargar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (TotalItems > 0)
            {
                <div class="uta-pagination-footer rounded-bottom mt-3">
                    <div class="uta-pagination-info">
                        <span class="small text-muted">
                            Se muestran <strong class="uta-text-highlight">@From</strong> a <strong class="uta-text-highlight">@To</strong> de <strong class="uta-text-highlight">@TotalItems</strong> facturas
                        </span>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted">por página</span>
                        <div class="uta-select-wrapper">
                            <select class="form-select form-select-sm shadow-none" @onchange="OnPageSizeChanged">
                                @foreach (var size in new[] { 5, 10, 25, 50 })
                                {
                                    <option value="@size" selected="@(_pageSize == size)">@size</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="d-flex overflow-hidden">
                        @foreach (var p in VisiblePages)
                        {
                            if (p == -1)
                            {
                                <span class="uta-pagination-btn uta-pagination-btn--ellipsis">...</span>
                            }
                            else
                            {
                                var pNum = p;
                                <button class="uta-pagination-btn @(pNum == _currentPage ? "uta-pagination-btn--active" : "")"
                                        @onclick="() => ChangePage(pNum)">@pNum</button>
                            }
                        }
                        <button class="uta-pagination-btn @(!HasNext ? "disabled" : "")"
                                @onclick="() => ChangePage(_currentPage + 1)"
                                disabled="@(!HasNext)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (_selectedInvoice != null)
{
    @if (_isDirectDownload)
    {
        <div style="position: fixed; inset: 0; background: rgba(107, 26, 51, 0.95); z-index: 9999; display: flex; flex-direction: column; justify-content: center; align-items: center; color: white;">
            <div style="font-size: 3.5rem; animation: spin 1.5s linear infinite; margin-bottom: 1rem;"><i class="bi bi-gear-fill"></i></div>
            <h2 style="margin: 0; font-family: 'Inter', sans-serif;">Generando Factura...</h2>
            <p style="font-family: 'Inter', sans-serif; opacity: 0.8;">La descarga comenzará en breve</p>
        </div>
    }

    <div class="uta-overlay" style="@(_isDirectDownload ? "z-index: 100; opacity: 0.01;" : "z-index: 1000;")" @onclick="CloseModal">
        <div class="uta-modal uta-modal--lg" @onclick:stopPropagation="true">
            <div class="uta-modal__header d-print-none">
                <div>
                    <h3 class="uta-modal__title"><i class="bi bi-receipt"></i> &nbsp;Detalle de Comprobante</h3>
                    <p class="uta-modal__subtitle">Revisión de artículos facturados</p>
                </div>
                <button id="btn-cerrar-modal" class="uta-modal__close" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
            </div>
            
            <div class="uta-modal__body bg-white printable-area" id="area-impresion" style="padding: 2rem;">
                
                <div style="display: flex; gap: 2rem; margin-bottom: 1.5rem; align-items: stretch;">
                    
                    <div style="flex: 1; display: flex; flex-direction: column; justify-content: center; border: 1px solid #e0e0e0; border-radius: 8px; padding: 1.5rem; text-align: center;">
                        <div style="width: 80px; height: 80px; background: #6B1A33; color: white; border-radius: 12px; margin: 0 auto 1rem auto; display: flex; align-items: center; justify-content: center; font-size: 2.5rem;">
                            <i class="bi bi-bag-check-fill"></i>
                        </div>
                        <h2 style="color: #6B1A33; font-weight: 800; margin: 0 0 0.5rem 0; font-size: 1.3rem;">MI NEGOCIO POS</h2>
                        <p style="margin: 0 0 0.2rem 0; font-size: 0.8rem; color: #555;"><strong>Dirección Matriz:</strong> Calle Principal y Secundaria</p>
                        <p style="margin: 0 0 0.2rem 0; font-size: 0.8rem; color: #555;"><strong>Teléfono:</strong> 0999 999 999</p>
                        <p style="margin: 0; font-size: 0.8rem; color: #555;">OBLIGADO A LLEVAR CONTABILIDAD: NO</p>
                    </div>

                    <div style="flex: 1; border: 1px solid #333; border-radius: 8px; padding: 1.5rem;">
                        <p style="margin: 0 0 0.5rem 0; font-size: 1rem; font-weight: 700;">R.U.C.: <span style="font-weight: 400;">9999999999001</span></p>
                        <h3 style="margin: 0 0 0.5rem 0; color: #1a1a1a; font-weight: 800; letter-spacing: 1px;">F A C T U R A</h3>
                        <p style="margin: 0 0 0.8rem 0; font-size: 1rem;">No. <strong style="color: #6B1A33;">@_selectedInvoice.InvoiceNumber</strong></p>
                        
                        <p style="margin: 0 0 0.2rem 0; font-size: 0.75rem; font-weight: 700;">NÚMERO DE AUTORIZACIÓN / CLAVE DE ACCESO</p>
                        <p style="margin: 0 0 0.8rem 0; font-size: 0.7rem; font-family: monospace; background: #f4f6f9; padding: 0.3rem; text-align: center; border-radius: 4px;">
                            @(DateTime.Now.ToString("ddMMyyyy"))0199999999990012001001@(_selectedInvoice.InvoiceNumber.Replace("FAC-", "").PadLeft(9, '0'))123456781
                        </p>
                        
                        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; margin-bottom: 0.3rem;">
                            <strong style="white-space: nowrap;">FECHA Y HORA:</strong>
                            <span style="text-align: right;">@FormatDate(_selectedInvoice.IssueDate)</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; font-size: 0.8rem;">
                            <strong>AMBIENTE:</strong> <span>PRODUCCIÓN</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; font-size: 0.8rem;">
                            <strong>EMISIÓN:</strong> <span>NORMAL</span>
                        </div>
                    </div>
                </div>

                <div style="border: 1px solid #e0e0e0; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.85rem;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                        <div><strong>Cliente:</strong> @ReorderName(_selectedInvoice.CustomerName)</div>
                        <div><strong>Identificación:</strong> @_selectedInvoice.CustomerIDCard</div>
                        <div><strong>Fecha Emisión:</strong> @FormatDate(_selectedInvoice.IssueDate)</div>
                        <div style="grid-column: span 2;"><strong>Dirección:</strong> @_selectedInvoice.CustomerAddress</div>
                        <div style="grid-column: span 2;"><strong>Correo:</strong> @_selectedInvoice.CustomerEmail</div>
                    </div>
                </div>

                <table style="width: 100%; border-collapse: collapse; margin-bottom: 1.5rem; font-size: 0.8rem;">
                    <thead>
                        <tr style="border: 1px solid #333; background: #f8f9fa;">
                            <th style="border: 1px solid #333; padding: 0.5rem; text-align: center;">Cod.</th>
                            <th style="border: 1px solid #333; padding: 0.5rem; text-align: center;">Cant</th>
                            <th style="border: 1px solid #333; padding: 0.5rem; text-align: left;">Descripción</th>
                            <th style="border: 1px solid #333; padding: 0.5rem; text-align: right;">P. Unitario</th>
                            <th style="border: 1px solid #333; padding: 0.5rem; text-align: right;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detalle in _selectedInvoice.Details)
                        {
                            <tr style="border-bottom: 1px solid #e0e0e0;">
                                <td style="border: 1px solid #e0e0e0; padding: 0.5rem; text-align: center;">@detalle.ProductId.ToString("D4")</td>
                                <td style="border: 1px solid #e0e0e0; padding: 0.5rem; text-align: center;">@detalle.Amount</td>
                                <td style="border: 1px solid #e0e0e0; padding: 0.5rem; font-weight: 600;">@detalle.ProductName</td>
                                <td style="border: 1px solid #e0e0e0; padding: 0.5rem; text-align: right;">$ @detalle.UnitPrice.ToString("N2")</td>
                                <td style="border: 1px solid #e0e0e0; padding: 0.5rem; text-align: right;">$ @detalle.SubTotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div style="display: flex; justify-content: flex-end;">
                    <div style="flex: 1.5;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem; border: 1px solid #333;">
                            <tbody>
                                <tr>
                                    <td style="border: 1px solid #e0e0e0; padding: 0.5rem; font-weight: 600;">SUBTOTAL</td>
                                    <td style="border: 1px solid #e0e0e0; padding: 0.5rem; text-align: right;">$ @_selectedInvoice.SubTotal.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid #e0e0e0; padding: 0.5rem; font-weight: 600;">IVA 15%</td>
                                    <td style="border: 1px solid #e0e0e0; padding: 0.5rem; text-align: right;">$ @_selectedInvoice.VatAmount.ToString("N2")</td>
                                </tr>
                                <tr style="background: #f8f9fa;">
                                    <td style="border: 1px solid #333; padding: 0.6rem; font-weight: 800; color: #6B1A33; font-size: 1rem;">VALOR TOTAL</td>
                                    <td style="border: 1px solid #333; padding: 0.6rem; text-align: right; font-weight: 800; font-size: 1.1rem; color: #6B1A33;">$ @_selectedInvoice.Total.ToString("N2")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="uta-modal__footer d-print-none">
                <button class="uta-btn uta-btn--outline" style="width: 100%" @onclick="CloseModal">Cerrar Visualización</button>
            </div>
        </div>
    </div>
}
@code {
    private PagedResponse<SaleResponseDto>? _pagedSalesResponse;
    private string _searchTerm = "";
    private string _searchCriterion = "number";
    private SaleResponseDto? _selectedInvoice;
    
    private bool _isDirectDownload = false;

    private int _currentPage = 1;
    private int _pageSize = 10;
    private CancellationTokenSource _searchCts = new();

    private int TotalItems => _pagedSalesResponse?.TotalCount ?? 0;
    private int TotalPages => _pagedSalesResponse?.TotalPages ?? 0;
    private int From => TotalItems == 0 ? 0 : ((_currentPage - 1) * _pageSize) + 1;
    private int To => Math.Min(_currentPage * _pageSize, TotalItems);
    private bool HasPrevious => _pagedSalesResponse?.HasPreviousPage ?? false;
    private bool HasNext => _pagedSalesResponse?.HasNextPage ?? false;
    private List<int> VisiblePages => PaginationHelper.GenerateVisiblePages(_currentPage, TotalPages);

    [SupplyParameterFromQuery(Name = "numeroFactura")]
    public string? InvoiceNumberQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _searchCts = new CancellationTokenSource();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(InvoiceNumberQuery) && _searchTerm != InvoiceNumberQuery)
        {
            _searchCriterion = "number";
            _searchTerm = InvoiceNumberQuery;
            await TriggerSearch(); // Use TriggerSearch to debounce
        }
    }

    private async Task FetchInvoices(int pageNumber)
    {
        _currentPage = pageNumber;
        _pagedSalesResponse = await ApiService.GetPagedSalesAsync(_currentPage, _pageSize, _searchTerm, _searchCriterion);
        StateHasChanged();
    }

    private async Task OnInputSearch(ChangeEventArgs e)
    {
        string rawInput = e.Value?.ToString() ?? "";
        _searchTerm = SanitizeInput(rawInput);

        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            _pagedSalesResponse = null;
            return;
        }

        await TriggerSearch();
    }

    private string SanitizeInput(string input)
    {
        // 1. Limit to 100 chars (UI limit)
        if (input.Length > 100) input = input.Substring(0, 100);

        // 2. Character filtering: Only letters and spaces for "customer"
        if (_searchCriterion == "customer")
        {
            input = new string(input.Where(c => char.IsLetter(c) || char.IsWhiteSpace(c)).ToArray());
        }

        // 3. Normalize spaces: Trim start/end, replace multiple spaces with one
        return System.Text.RegularExpressions.Regex.Replace(input.Trim(), @"\s+", " ");
    }

    private async Task OnSearchCriteriaChanged()
    {
        _searchTerm = ""; 
        _pagedSalesResponse = null; 
        _currentPage = 1;
    }

    private async Task OnSearchInputKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await TriggerSearch();
        }
    }

    private async Task TriggerSearch()
    {
        _currentPage = 1; 
        _searchCts.Cancel(); 
        _searchCts = new CancellationTokenSource();

        try 
        {
            await Task.Delay(300, _searchCts.Token);
            await FetchInvoices(_currentPage);
        }
        catch (TaskCanceledException) { }
    }

    // Method to handle the search button click, which should also trigger search
    private async Task SearchInvoices()
    {
       await TriggerSearch();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize))
        {
            _pageSize = newSize;
            _currentPage = 1;
            await FetchInvoices(_currentPage);
        }
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage >= 1 && newPage <= TotalPages)
        {
            await FetchInvoices(newPage);
        }
    }

    private async Task PreviousPage() => await ChangePage(_currentPage - 1);
    private async Task NextPage() => await ChangePage(_currentPage + 1);

    // 1. Abre el modal para solo leer
    private void ViewDetail(SaleResponseDto invoice)
    {
        _isDirectDownload = false;
        _selectedInvoice = invoice;
    }

    // 2. Invoca la librería JS para descargar sin preguntar
    private async Task DownloadDirect(SaleResponseDto invoice)
    {
        _isDirectDownload = true;
        _selectedInvoice = invoice;

        StateHasChanged();
        await Task.Delay(200);

        string safeDate = DateTime.TryParse(_selectedInvoice.IssueDate, out DateTime f) 
            ? f.ToString("dd-MM-yyyy_HH-mm-ss") 
            : _selectedInvoice.IssueDate.Replace(":", "-");
        string documentName = $"{_selectedInvoice.InvoiceNumber}_{safeDate}.pdf";

        await JS.InvokeVoidAsync("eval", $@"
            var element = document.getElementById('area-impresion');
            var opt = {{
              margin:       [10, 10, 10, 10],
              filename:     '{documentName}',
              image:        {{ type: 'jpeg', quality: 0.98 }},
              html2canvas:  {{ scale: 2, useCORS: true }},
              jsPDF:        {{ unit: 'mm', format: 'a4', orientation: 'portrait' }}
            }};

            html2pdf().set(opt).from(element).save().then(function() {{
                var btnCerrar = document.getElementById('btn-cerrar-modal');
                if (btnCerrar) btnCerrar.click();
            }});
        ");
    }

    private void CloseModal()
    {
        _selectedInvoice = null;
        _isDirectDownload = false;
    }

    private string FormatDate(string rawDate)
    {
        if (string.IsNullOrWhiteSpace(rawDate)) return "N/A";
        if (DateTime.TryParse(rawDate, out DateTime date))
        {
            return date.ToString("dd/MM/yyyy HH:mm:ss");
        }
        return rawDate;
    }

    private string ReorderName(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return fullName;
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            var lastName = parts.Last();
            var firstNames = string.Join(" ", parts.Take(parts.Length - 1));
            return $"{lastName} {firstNames}";
        }
        return fullName;
    }

    public void Dispose()
    {
        _searchCts.Cancel();
        _searchCts.Dispose();
    }
}

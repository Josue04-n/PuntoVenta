    private async Task FinalizeSale()
    {
        if (_selectedCustomerEntity == null)
        {
            await ShowNotification("Debe seleccionar un cliente antes de procesar la venta.", true);
            return;
        }

        foreach (var item in _cart)
        {
            if (item.Amount > item.Product.Stock)
            {
                await ShowNotification($"Stock insuficiente para '{item.Product.Name}'. Disponible: {item.Product.Stock}.", true);
                return; 
            }
        }

        var saleRequest = new Application.DTOs.CreateSaleRequest
        {
            CustomerId = _selectedCustomerEntity.Id,
            Details = _cart.Select(item => new CreateRequestDetail
            {
                ProductId = item.Product.Id,
                Amount = item.Amount
            }).ToList()
        };

        try 
        {
            var httpResponse = await ApiService.CreateSaleAsync(saleRequest);

            if (httpResponse.IsSuccessStatusCode)
            {
                var jsonContent = await httpResponse.Content.ReadAsStringAsync();
                using var jsonDoc = System.Text.Json.JsonDocument.Parse(jsonContent);

                if (jsonDoc.RootElement.TryGetProperty("invoiceNumber", out var invoiceProp))
                {
                    _invoiceNumber = invoiceProp.GetString() ?? "AUTHORIZED";
                }

                await ShowNotification("Venta procesada y stock actualizado exitosamente!");
                _saleCompleted = true;
                StateHasChanged();
            }
            else
            {
                var jsonContent = await httpResponse.Content.ReadAsStringAsync();
                bool errorHandled = false;

                try 
                {
                    var jsonDoc = System.Text.Json.JsonDocument.Parse(jsonContent);
                    if (jsonDoc.RootElement.TryGetProperty("type", out var t))
                    {
                        var errorType = t.GetString();

                        if (errorType == "BulkStock")
                        {
                            var options = new System.Text.Json.JsonSerializerOptions 
                            { 
                                PropertyNameCaseInsensitive = true,
                                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
                            };
                            var errorResponse = System.Text.Json.JsonSerializer.Deserialize<BulkStockErrorResponse>(jsonContent, options);
                            if (errorResponse != null && errorResponse.Errors != null && errorResponse.Errors.Any())
                            {
                                var htmlMessage = "<div class='uta-swal-list-container'><ul class='uta-swal-list'>";
                                foreach (var error in errorResponse.Errors)
                                {
                                    htmlMessage += $"<li><i class='bi bi-dot'></i> <strong>{error.ProductName}</strong>: Solicitaste {error.RequestedQuantity}, pero solo hay {error.AvailableStock} en stock.</li>";
                                }
                                htmlMessage += "</ul></div>";

                                await JS.InvokeVoidAsync("Swal.fire", new
                                {
                                    icon = "error",
                                    title = "Ajuste de Inventario",
                                    html = htmlMessage,
                                    confirmButtonText = "Entendido",
                                    buttonsStyling = false,
                                    customClass = new {
                                        container = "uta-swal-container",
                                        popup = "uta-swal-popup",
                                        title = "uta-swal-title",
                                        htmlContainer = "uta-swal-html",
                                        confirmButton = "uta-btn uta-btn--primary uta-btn--lg" 
                                    },
                                    showClass = new {
                                        popup = "animate__animated animate__fadeInUp" 
                                    }
                                });

                                RemoveOutOfStockProducts(errorResponse.Errors);
                                errorHandled = true;
                            }
                        }
                        else if (errorType == "ProductDeleted")
                        {
                            var options = new System.Text.Json.JsonSerializerOptions 
                            { 
                                PropertyNameCaseInsensitive = true,
                                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
                            };
                            var errorResponse = System.Text.Json.JsonSerializer.Deserialize<ProductDeletedErrorResponse>(jsonContent, options);
                            if (errorResponse != null && errorResponse.DeletedProducts != null && errorResponse.DeletedProducts.Any())
                            {
                                var htmlMessage = "<div class='uta-swal-list-container'><ul class='uta-swal-list'>";
                                foreach (var prod in errorResponse.DeletedProducts)
                                {
                                    htmlMessage += $"<li><i class='bi bi-dot'></i> Producto <strong>{prod.ProductName}</strong> (ID: {prod.ProductId}) ya no está disponible.</li>";
                                }
                                htmlMessage += "</ul></div>";

                                await JS.InvokeVoidAsync("Swal.fire", new
                                {
                                    icon = "error",
                                    title = "Productos No Disponibles",
                                    html = htmlMessage,
                                    confirmButtonText = "Entendido",
                                    buttonsStyling = false,
                                    customClass = new {
                                        container = "uta-swal-container",
                                        popup = "uta-swal-popup",
                                        title = "uta-swal-title",
                                        htmlContainer = "uta-swal-html",
                                        confirmButton = "uta-btn uta-btn--primary uta-btn--lg" 
                                    },
                                    showClass = new {
                                        popup = "animate__animated animate__fadeInUp" 
                                    }
                                });

                                foreach (var prod in errorResponse.DeletedProducts)
                                {
                                    var item = _cart.FirstOrDefault(c => c.Product.Id == prod.ProductId);
                                    if (item != null) _cart.Remove(item);
                                }
                                errorHandled = true;
                            }
                        }
                    }
                }
                catch (Exception exDeserialize)
                {
                    Console.WriteLine($"Error parsing JSON: {exDeserialize.Message}");
                }

                if (!errorHandled)
                {
                    await ShowNotification($"Error inesperado en el servidor: {jsonContent}", true);
                }
                
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await ShowNotification("Error crítico de comunicación con el servidor.", true);
            Console.WriteLine($"Error técnico: {ex.Message}");
        }
    }
    
    private void ViewInvoice()
    {
        NavManager.NavigateTo($"/facturas?numeroFactura={_invoiceNumber}");
    }
    
    private async Task NewSale()
    {
        _cart.Clear(); _selectedCustomerEntity = null; _saleCompleted = false; _invoiceNumber = "DRAFT";
        RecalculateInvoiceTotals();
        await ShowNotification("Formulario de venta restablecido");
    }
}
@page "/ventas"
@using Application.DTOs
@using Application.DTOs.Common
@using Blazor.Helpers
@using Blazor.Models
@using Blazor.Services
@using System.Timers
@using System.Text.Json
@inject IJSRuntime JS
@inject PosApiService ApiService
@inject CustomerApiService CustomerApiService
@inject NavigationManager NavManager
@* @attribute [Authorize] *@

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

@if (!string.IsNullOrEmpty(_alertMessage))
{
    <div class="uta-toast-wrapper">
        <div class="uta-toast @(_isError ? "uta-toast--error" : "uta-toast--success")">
            <div class="uta-toast__icon">
                <i class="bi @(_isError ? "bi-exclamation-triangle-fill" : "bi-check2-circle")"></i>
            </div>
            <div class="uta-toast__body">
                <div class="uta-toast__title">@(_isError ? "Atención" : "Exito!")</div>
                <div class="uta-toast__message">@_alertMessage</div>
            </div>
            <button class="uta-toast__close" @onclick="() => _alertMessage = string.Empty">
                <i class="bi bi-x"></i>
            </button>
            <div class="uta-toast__progress"></div>
        </div>
    </div>
}

<div class="uta-page">
    <div class="uta-page-header">
        <div class="uta-page-header__left">
            <div class="uta-breadcrumb">
                <span>Panel Principal</span>
                <span class="uta-breadcrumb__sep"></span>
                <span class="uta-breadcrumb__active">Punto de Venta</span>
            </div>
            <h1 class="uta-page-title">
                <i class="bi bi-cart-check text-warning uta-page-title__icon"></i>
                Punto de Venta
            </h1>
            <p class="uta-page-subtitle">Registro y procesamiento de ventas al cliente</p>
        </div>
        <div class="uta-page-header__right d-print-none">
            @if (!_saleCompleted)
            {
                <button class="uta-btn uta-btn--primary" @onclick="FinalizeSale" disabled="@(!CanFinalize)">
                    <i class="bi bi-check2-all"></i> &nbsp;Procesar Venta
                </button>
            }
            else
            {
                <button class="uta-btn uta-btn--outline" @onclick="NewSale">
                    <i class="bi bi-arrow-counterclockwise"></i> &nbsp;Nueva Venta
                </button>
                <button class="uta-btn uta-btn--success" @onclick="ViewInvoice">
                    <i class="bi bi-receipt"></i> &nbsp;Ver Factura
                </button>
            }
        </div>
    </div>

    <div class="uta-stats-row">
        <div class="uta-stat-card uta-stat-card--light">
            <div class="uta-stat-card__icon text-primary"><i class="bi bi-box-seam"></i></div>
            <div class="uta-stat-card__details">
                <div class="uta-stat-card__number">@_cart.Count</div>
                <div class="uta-stat-card__label">Productos en Carrito</div>
            </div>
        </div>
        <div class="uta-stat-card uta-stat-card--light">
            <div class="uta-stat-card__icon text-warning"><i class="bi bi-calculator"></i></div>
            <div class="uta-stat-card__details">
                <div class="uta-stat-card__number">
                    <div class="uta-price">
                        <span class="uta-price__symbol">$</span>
                        <span class="uta-price__value">@GlobalSubtotal.ToString("N2")</span>
                    </div>
                </div>
                <div class="uta-stat-card__label">Subtotal Venta</div>
            </div>
        </div>
        <div class="uta-stat-card uta-stat-card--light">
            <div class="uta-stat-card__icon text-info"><i class="bi bi-percent"></i></div>
            <div class="uta-stat-card__details">
                <div class="uta-stat-card__number">
                    <div class="uta-price">
                        <span class="uta-price__symbol">$</span>
                        <span class="uta-price__value">@GlobalVat.ToString("N2")</span>
                    </div>
                </div>
                <div class="uta-stat-card__label">Impuestos (IVA 15%)</div>
            </div>
        </div>
        <div class="uta-stat-card uta-stat-card--dark">
            <div class="uta-stat-card__icon"><i class="bi bi-cash-coin"></i></div>
            <div class="uta-stat-card__details">
                <div class="uta-stat-card__number">
                    <div class="uta-price">
                        <span class="uta-price__symbol">$</span>
                        <span class="uta-price__value">@FinalTotal.ToString("N2")</span>
                    </div>
                </div>
                <div class="uta-stat-card__label">Monto Total a Pagar</div>
            </div>
        </div>
    </div>

    <div class="uta-content-grid">
        <div class="uta-main-col">
            <div class="uta-card">
                <div class="uta-card__header">
                    <div class="uta-card__header-left">
                        <i class="bi bi-person-badge uta-card__header-icon"></i>
                        Datos del Cliente
                    </div>
                    @if (!_saleCompleted)
                    {
                        <button class="uta-btn uta-btn--sm uta-btn--white d-print-none" @onclick="OpenCustomerModal">
                            <i class="bi bi-person-plus"></i> &nbsp;Asignar Cliente
                        </button>
                    }
                </div>
                <div class="uta-card__body">
                    <div class="uta-client-header">
                        <div class="uta-client-avatar">
                            @(_selectedCustomerEntity?.Name?.Length > 0 && _selectedCustomerEntity?.LastName?.Length > 0 ? $"{_selectedCustomerEntity.Name[0]}{_selectedCustomerEntity.LastName[0]}" : "CF")
                        </div>
                        <div class="uta-client-title">
                            <h4 class="uta-client-name">
                                @(_selectedCustomerEntity != null ? $"{_selectedCustomerEntity.Name} {_selectedCustomerEntity.LastName}" : "CONSUMIDOR FINAL")
                            </h4>
                            <span class="uta-badge uta-badge--blue">@(_selectedCustomerEntity != null ? "Cliente Registrado" : "Venta Estándar")</span>
                        </div>
                    </div>
                    
                    <div class="uta-client-data-grid">
                        <div class="uta-data-item">
                            <span class="uta-data-item__label">Cédula </span>
                            <span class="uta-data-item__value">@(_selectedCustomerEntity != null ? _selectedCustomerEntity.IDCard : "-")</span>
                        </div>
                        <div class="uta-data-item">
                            <span class="uta-data-item__label">Teléfono</span>
                            <span class="uta-data-item__value">@(_selectedCustomerEntity != null && !string.IsNullOrEmpty(_selectedCustomerEntity.Phone) ? _selectedCustomerEntity.Phone : "-")</span>
                        </div>
                        <div class="uta-data-item">
                            <span class="uta-data-item__label">Correo Electrónico</span>
                            <span class="uta-data-item__value">@(_selectedCustomerEntity != null && !string.IsNullOrEmpty(_selectedCustomerEntity.Email) ? _selectedCustomerEntity.Email : "-")</span>
                        </div>
                        <div class="uta-data-item uta-data-item--full">
                            <span class="uta-data-item__label">Dirección Completa</span>
                            <span class="uta-data-item__value">@(_selectedCustomerEntity != null && !string.IsNullOrEmpty(_selectedCustomerEntity.Address) ? _selectedCustomerEntity.Address : "-")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="uta-card">
                <div class="uta-card__header">
                    <div class="uta-card__header-left">
                        <i class="bi bi-cart4 uta-card__header-icon"></i>
                        Detalle de Productos
                        @if (_cart.Any())
                        {
                            <span class="uta-badge uta-badge--white-outline ms-2">@_cart.Count items</span>
                        }
                    </div>
                    @if (!_saleCompleted)
                    {
                        <button class="uta-btn uta-btn--sm uta-btn--white d-print-none" @onclick="async () => await OpenProductModal()">

                            <i class="bi bi-plus-lg"></i> &nbsp;Agregar Producto
                        </button>
                    }
                </div>
                <div class="uta-card__body p-0">

                    <div class="uta-table-wrap">
                        <table class="uta-table">
                            <thead>
                                <tr>
                                    <th style="width:80px">Código</th>
                                    <th style="width:60px;text-align:center">Cant.</th>
                                    <th>Descripción</th>
                                    <th style="text-align:right;width:120px">P. Unitario</th>
                                    <th style="text-align:right;width:120px">P. Total</th>
                                    @if (!_saleCompleted) { <th style="width:44px" class="d-print-none"></th> }
                                </tr>
                            </thead>
                            <tbody>
                                @if (!_cart.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="uta-table__empty">
                                            <div class="uta-empty-state">
                                                <div class="uta-empty-state__icon"><i class="bi bi-box-seam"></i></div>
                                                <div class="uta-empty-state__text">El carrito está vacío</div>
                                                <div class="uta-empty-state__sub">Presione "Agregar Producto" para comenzar a facturar</div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @foreach (var item in PagedCart)
                                {
                                    <tr>
                                        <td><span class="uta-code-badge">@item.ProductId.ToString("D4")</span></td>
                                        <td style="text-align:center">
                                            <input class="uta-qty-input uta-qty-input--cart" 
                                                   type="number" 
                                                   value="@item.Amount" 
                                                   @oninput="@((e) => UpdateQuantity(item, e))"
                                                   min="1"
                                                   onkeypress="return (event.charCode >= 48 && event.charCode <= 57)" />
                                            <div class="uta-stock-hint" @onclick="() => { item.Amount = item.AvailableStock; RecalculateInvoiceTotals(); }" style="cursor:pointer">
                                                Disponible: <strong>@item.AvailableStock</strong>
                                            </div>
                                        </td>
                                        <td class="uta-table__bold">@item.ProductName</td>

                                        <td style="text-align:right;color:#666">
                                            <div class="uta-price uta-price--right">
                                                <span class="uta-price__symbol">$</span>
                                                <span class="uta-price__value">@item.UnitPrice.ToString("N2")</span>
                                            </div>
                                        </td>

                                        <td style="text-align:right;font-weight:600;color:#1a1a1a">
                                            <div class="uta-price uta-price--right">
                                                <span class="uta-price__symbol">$</span>
                                                <span class="uta-price__value">@item.SubTotal.ToString("N2")</span>
                                            </div>
                                        </td>
                                        @if (!_saleCompleted)
                                        {
                                            <td class="d-print-none" style="text-align:center">
                                                <button class="uta-icon-btn uta-icon-btn--red" title="Quitar" @onclick="() => RemoveFromCart(item)">
                                                    <i class="bi bi-trash3-fill"></i>
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (_cart.Any())
                    {
                        <div class="uta-pagination-footer d-print-none">
                            <div class="uta-pagination-info">
                                <span class="small text-muted">
                                    Se muestran <strong class="uta-text-highlight">@CartFrom</strong> a <strong class="uta-text-highlight">@CartTo</strong> de <strong class="uta-text-highlight">@_cart.Count</strong> productos
                                </span>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <span class="small text-muted">por página</span>
                                <div class="uta-select-wrapper">
                                    <select class="form-select form-select-sm shadow-none" @onchange="OnCartPageSizeChanged">
                                        @foreach (var size in new[] { 5, 10, 25 })
                                        {
                                            <option value="@size" selected="@(_cartPageSize == size)">@size</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="d-flex overflow-hidden">
                                @foreach (var p in VisiblePagesCart)
                                {
                                    if (p == -1)
                                    {
                                        <span class="uta-pagination-btn uta-pagination-btn--ellipsis">...</span>
                                    }
                                    else
                                    {
                                        var pNum = p;
                                        <button class="uta-pagination-btn @(pNum == _currentCartPage ? "uta-pagination-btn--active" : "")"
                                                @onclick="() => GoToCartPage(pNum)">@pNum</button>
                                    }
                                }
                                <button class="uta-pagination-btn @(!HasNextCartPage ? "disabled" : "")"
                                        @onclick="() => GoToCartPage(_currentCartPage + 1)"
                                        disabled="@(!HasNextCartPage)">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="uta-side-col">
            <div class="uta-card uta-card--sticky">
                <div class="uta-card__header">
                    <div class="uta-card__header-left">
                        <i class="bi bi-clipboard2-data uta-card__header-icon"></i>
                        Resumen de Transacción
                    </div>
                </div>
                <div class="uta-card__body">
                    <div class="uta-biz-info mb-3">
                        <div class="uta-biz-name"><i class="bi bi-shop"></i> MI NEGOCIO POS</div>
                        <div class="uta-biz-detail"><i class="bi bi-geo-alt-fill"></i> Calle Principal y Secundaria</div>
                        <div class="uta-biz-detail"><i class="bi bi-telephone-fill"></i> 0999 999 999</div>
                        <div class="uta-biz-detail"><i class="bi bi-file-earmark-text-fill"></i> RUC: 9999999999001</div>
                    </div>

                    <div class="uta-divider"></div>

                    <div class="uta-invoice-meta">
                        <div class="uta-invoice-row">
                            <span class="uta-invoice-label">Documento</span>
                            <span class="uta-invoice-value text-danger">FACTURA</span>
                        </div>
                        <div class="uta-invoice-row">
                            <span class="uta-invoice-label">Número</span>
                            <span class="uta-invoice-value uta-invoice-value--code">@_invoiceNumber</span>
                        </div>
                        <div class="uta-invoice-row">
                            <span class="uta-invoice-label">Emisión</span>
                            <span class="uta-invoice-value">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="uta-invoice-row mt-1">
                            <span class="uta-invoice-label">Estado</span>
                            <span class="uta-badge @(_saleCompleted ? "uta-badge--green" : "uta-badge--yellow")">
                                @if (_saleCompleted)
                                {
                                    <i class="bi bi-check-circle-fill me-1"></i> <span>Procesada</span>
                                }
                                else
                                {
                                    <i class="bi bi-hourglass-split me-1"></i> <span>Borrador</span>
                                }
                            </span>
                        </div>
                    </div>

                    <div class="uta-divider"></div>

                    <div class="uta-totals">
                        <div class="uta-totals__row">
                            <span>Subtotal</span>
                            <span class="uta-price uta-price--right">
                                <span class="uta-price__symbol">$</span>
                                <span class="uta-price__value">@GlobalSubtotal.ToString("N2")</span>
                            </span>
                        </div>
                        <div class="uta-totals__row">
                            <span>IVA 15%</span>
                            <span class="uta-price uta-price--right">
                                <span class="uta-price__symbol">$</span>
                                <span class="uta-price__value">@GlobalVat.ToString("N2")</span>
                            </span>
                        </div>
                        <div class="uta-totals__grand mt-2">
                            <span>TOTAL A PAGAR</span>
                            <span class="uta-price uta-price--right">
                                <span class="uta-price__symbol">$</span>
                                <span class="uta-price__value">@FinalTotal.ToString("N2")</span>
                            </span>
                        </div>
                    </div>

                    <div class="d-print-none" style="margin-top: 1.5rem">
                        @if (!_saleCompleted)
                        {
                            <!-- Bot�n Primario: M�s grande y llamativo -->
                            <button class="uta-btn uta-btn--primary uta-btn--lg" 
                                    @onclick="FinalizeSale" 
                                    disabled="@(!CanFinalize)">
                                <i class="bi bi-check2-all"></i> PROCESAR VENTA
                            </button>

                            <!-- Bot�n Secundario: Outline para indicar que es una acci�n de retroceso -->
                            <button type="button" 
                                    class="uta-btn-pos uta-btn-pos--cancel" 
                                    @onclick="CancelSale">
                                <i class="bi bi-x-circle"></i> CANCELAR FACTURA
                            </button>

                            @if (!CanFinalize)
                            {
                                <p class="uta-hint mt-2">
                                    <i class="bi bi-exclamation-triangle-fill"></i> 
                                    @if (!_cart.Any())
                                    {
                                        <span>El carrito requiere al menos un producto</span>
                                    }
                                    else if (_selectedCustomerEntity == null)
                                    {
                                        <span>Asigne un cliente para facturar</span>
                                    }
                                    else
                                    {
                                        <span>Ajuste las cantidades al stock disponible</span>
                                    }
                                </p>
                            }
                        }
                        else
                        {
                            <button class="uta-btn uta-btn--success uta-btn--block uta-btn--lg mb-2" @onclick="ViewInvoice">
                                <i class="bi bi-receipt"></i> &nbsp; VER FACTURA
                            </button>
                            <button class="uta-btn uta-btn--outline uta-btn--block" @onclick="NewSale">
                                <i class="bi bi-arrow-counterclockwise"></i> &nbsp; NUEVA VENTA
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-print-none">

    @if (_showCustomerModal)
    {
        <div class="uta-overlay" @onclick="CloseCustomerModal">
            <div class="uta-modal uta-modal--xl" @onclick:stopPropagation="true">
                <div class="uta-modal__header">
                    <div>
                        <h3 class="uta-modal__title"><i class="bi bi-people-fill"></i> &nbsp;Directorio de Clientes</h3>
                        <p class="uta-modal__subtitle">Busque y seleccione el cliente para esta venta</p>
                    </div>
                    <button class="uta-modal__close" @onclick="CloseCustomerModal"><i class="bi bi-x-lg"></i></button>
                </div>

                <div class="uta-modal__body">
                    <div class="uta-search-bar">
                        <select class="uta-search-bar__select" @bind="CustomerSearchCriterion">
                            <option value="card">Cédula</option>
                            <option value="name">Apellido</option>
                            <option value="id">ID Interno</option>
                        </select>

                        <input class="uta-search-bar__input" 
                               type="text" 
                               value="@_customerTerm"
                               @oninput="InputCustomerSearch"
                               maxlength="@(CustomerSearchCriterion == "name" ? 25 : 10)"
                               onkeypress="@GetOnKeyPressHandler(CustomerSearchCriterion)"
                               placeholder="Escriba para filtrar clientes..."/>

                        <button class="uta-btn uta-btn--primary uta-search-bar__btn" @onclick="LoadClientsAsync">
                            <i class="bi bi-search"></i>
                        </button>

                    </div>
                    <div class="uta-table-wrap uta-table-wrap--bordered">
                        <table class="uta-table">
                            <thead>
                                <tr>
                                    <th style="width: 80px; text-align: center;">C�digo (ID)</th>
                                    <th>Nombre Completo</th>
                                    <th style="text-align:center">Cédula</th>
                                    <th style="text-align:center">Teléfono</th>
                                    <th>Dirección</th>
                                    <th>Correo</th>
                                    <th style="text-align:center">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!PagedCustomers.Any() && !string.IsNullOrEmpty(_customerTerm))
                                {
                                    <tr>
                                        <td colspan="7" class="uta-table__empty">
                                            <div class="uta-empty-state">
                                                <div class="uta-empty-state__icon"><i class="bi bi-search"></i></div>
                                                <div class="uta-empty-state__text">Sin resultados para "@_customerTerm"</div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @foreach (var c in PagedCustomers)
                                {
                                    <tr>
                                        <td style="text-align:center"><span class="uta-code-badge">@c.Id.ToString("D3")</span></td>
                                        <td class="uta-table__bold"> @c.LastName @c.Name</td>
                                        <td style="text-align:center"><span class="uta-code-badge">@c.IDCard</span></td>
                                        <td style="text-align:center;color:#666">@(string.IsNullOrEmpty(c.Phone) ? "-" : c.Phone)</td>
                                        <td style="color:#666">@(string.IsNullOrEmpty(c.Address) ? "-" : c.Address)</td>
                                        <td style="color:#666">@(string.IsNullOrEmpty(c.Email) ? "-" : c.Email)</td>
                                        <td style="text-align:center">
                                            <button class="uta-btn uta-btn--sm uta-btn--success" @onclick="() => SelectCustomer(c)">
                                                <i class="bi bi-check2"></i> Seleccionar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (_totalCustomerItems > 0)
                {
                    <div class="uta-pagination-footer rounded-bottom">
    
    @* Info de resultados para Clientes *@
    <div class="uta-pagination-info">
        <span class="small text-muted">
            Se muestran <strong class="uta-text-highlight">@CustomerFrom</strong> a <strong class="uta-text-highlight">@CustomerTo</strong> de <strong class="uta-text-highlight">@_totalCustomerItems</strong> resultados
        </span>
    </div>

    @* Selector de tama�o de p�gina para Clientes *@
    <div class="d-flex align-items-center gap-2">
        <span class="small text-muted">por página</span>
        <div class="uta-select-wrapper">
            <select class="form-select form-select-sm shadow-none" 
                    @onchange="OnCustomerPageSizeChanged">
                @foreach (var size in new[] { 5, 10, 25, 50 })
                {
                    <option value="@size" selected="@(_customerItemsPerPage == size)">@size</option>
                }
            </select>
        </div>
    </div>

    @* Navegaci�n con Ellipsis usando tu PaginationHelper *@
    <div class="d-flex overflow-hidden">
        @foreach (var p in VisiblePagesCustomer)
        {
            if (p == -1)
            {
                <span class="uta-pagination-btn uta-pagination-btn--ellipsis">...</span>
            }
            else
            {
                var pNum = p;
                <button class="uta-pagination-btn @(pNum == _currentCustomerPageIdx ? "uta-pagination-btn--active" : "")"
                        @onclick="() => GoToCustomerPage(pNum)">@pNum</button>
            }
        }
        <button class="uta-pagination-btn @(!HasNextCustomerPage ? "disabled" : "")"
                @onclick="() => GoToCustomerPage(_currentCustomerPageIdx + 1)"
                disabled="@(!HasNextCustomerPage)">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>
</div>
                }
            </div>
        </div>
    }

@* Cat�logo de Productos Paginado *@
@if (_showProductModal)
{
    <div class="uta-overlay" @onclick="CloseProductModal">
        <div class="uta-modal uta-modal--lg" @onclick:stopPropagation="true">
            <div class="uta-modal__header">
                <div>
                    <h3 class="uta-modal__title"><i class="bi bi-boxes"></i> &nbsp;Catálogo de Productos</h3>
                    <p class="uta-modal__subtitle">Búsqueda optimizada por Descripción o Código ID</p>
                </div>
                <button class="uta-modal__close" @onclick="CloseProductModal"><i class="bi bi-x-lg"></i></button>
            </div>

            <div class="uta-modal__body">
                @* Barra de B�squeda Proactiva *@
                <div class="uta-search-bar mb-3">
                    <select class="uta-search-bar__select" @bind="ProductSearchCriterion">
                        <option value="name">Descripción</option> @* 'name' para el default *@
                        <option value="id">Código ID</option>     @* 'id' para el filtro num�rico *@
                    </select>
                    <input class="uta-search-bar__input" 
                           type="text" 
                           value="@_searchTerm" 
                           @oninput="OnInputSearch"
                           placeholder="Escriba para buscar..." />
                    <div class="uta-search-bar__icon-container px-3 d-flex align-items-center bg-light">
                        <i class="bi bi-search text-muted"></i>
                    </div>
                </div>

                @* Marcado del Modal Optimizado *@

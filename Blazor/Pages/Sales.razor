    private async Task LoadDraft(Blazor.Models.SaleResponseDto draft)
    {
        _cart.Clear();
        _loadedDraftId = draft.Id;
        _invoiceNumber = draft.InvoiceNumber;

        // Recuperar info del cliente (puede necesitar hacer una llamada al API si faltan campos)
        _selectedCustomerEntity = new CustomerModel
        {
            Name = draft.CustomerName,
            LastName = "", // Viene combinado en CustomerName
            IDCard = draft.CustomerIDCard,
            Phone = draft.CustomerPhone,
            Address = draft.CustomerAddress,
            Email = draft.CustomerEmail
        };

        foreach (var detail in draft.Details)
        {
            var product = await ApiService.GetProductByIdAsync(detail.ProductId);
            _cart.Add(new CartItemModel
            {
                ProductId = detail.ProductId,
                ProductName = detail.ProductName,
                UnitPrice = detail.UnitPrice,
                Amount = detail.Amount,
                AvailableStock = product?.Stock ?? detail.Amount,
                Product = new ProductModel { Id = detail.ProductId, Name = detail.ProductName, UnitPrice = detail.UnitPrice, Stock = product?.Stock ?? detail.Amount }
            });
        }

        _saleCompleted = false;
        _saleStatus = Domain.Enums.SaleStatus.Draft;
        RecalculateInvoiceTotals();
        CloseDraftsModal();
        await ShowNotification($"Borrador {_invoiceNumber} recuperado para edición");
    }

    private async Task ProcessSaleAction(bool confirmImmediately)
    {
        if (_isProcessingSale) return;

        _isProcessingSale = true;
        StateHasChanged();

        var saleRequest = new Application.DTOs.CreateSaleRequest
        {
            DraftId = _loadedDraftId > 0 ? _loadedDraftId : null,
            CustomerId = _selectedCustomerEntity!.Id > 0 ? _selectedCustomerEntity.Id : 1, // ID válido necesario
            Details = _cart.Select(item => new CreateRequestDetail
            {
                ProductId = item.Product.Id,
                Amount = item.Amount
            }).ToList()
        };

        try 
        {
            var httpResponse = await ApiService.CreateSaleAsync(saleRequest);

            if (httpResponse.IsSuccessStatusCode)
            {
                var jsonContent = await httpResponse.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<Blazor.Models.SaleResponseDto>(jsonContent, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                if (result != null)
                {
                    _invoiceNumber = result.InvoiceNumber;
                    _createdSaleId = result.Id;
                    _saleStatus = result.Status;
                }

                _saleCompleted = true;

                if (confirmImmediately)
                {
                    await ConfirmDraft();
                }
                else
                {
                    await ShowNotification("Borrador guardado. Puede confirmarlo en cualquier momento.");
                }
            }
            else
            {
                var error = await httpResponse.Content.ReadAsStringAsync();
                await JS.InvokeVoidAsync("Swal.fire", "Error", "No se pudo procesar: " + error, "error");
                _saleCompleted = false;
            }
        }
        catch (Exception)
        {
            await ShowNotification("Error de comunicación.", true);
            _saleCompleted = false;
        }
        finally
        {
            _isProcessingSale = false;
            StateHasChanged();
        }
    }

    private async Task SaveAsDraft()
    {
        await ProcessSaleAction(false);
    }

    private async Task SellAndConfirm()
    {
        await ProcessSaleAction(true);
    }

    private async Task PromptImmediateConfirmation()
    {
        var result = await JS.InvokeAsync<object>("Swal.fire", new
        {
            title = "Venta Registrada",
            text = "¿Desea confirmar y cobrar esta venta ahora mismo? Esto descontará el stock.",
            icon = "question",
            showCancelButton = true,
            confirmButtonColor = "#16a34a",
            cancelButtonColor = "#6c757d",
            confirmButtonText = "Sí, Confirmar",
            cancelButtonText = "Mantener como Borrador"
        });

        if (await Confirmed(result))
        {
            await ConfirmDraft();
        }
    }

    private async Task ConfirmDraft()
    {
        _isProcessingSale = true;
        StateHasChanged();

        var response = await ApiService.ConfirmSaleAsync(_createdSaleId);
        if (response.IsSuccessStatusCode)
        {
            _saleStatus = Domain.Enums.SaleStatus.Confirmed;
            await ShowNotification("¡Venta confirmada y stock actualizado!");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("Swal.fire", "Error de Stock", "No se pudo confirmar: " + error, "warning");
        }

        _isProcessingSale = false;
        StateHasChanged();
    }

    private void ViewInvoice()
    {
        NavManager.NavigateTo($"/facturas?numeroFactura={_invoiceNumber}");
    }
    
    private async Task NewSale()
    {
        _cart.Clear(); 
        _selectedCustomerEntity = null; 
        _saleCompleted = false; 
        _invoiceNumber = "DRAFT";
        _loadedDraftId = 0;
        _saleStatus = Domain.Enums.SaleStatus.Draft;
        RecalculateInvoiceTotals();
        await LoadData(); // Refrescar stock por si hubo confirmaciones
        await ShowNotification("Formulario de venta restablecido");
    }
}

@page "/"
@using System.Globalization
@inject NavigationManager NavManager

<PageTitle>Panel de Control - MI NEGOCIO</PageTitle>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

<div class="uta-page">
    <div class="uta-page-header">
        <div class="uta-page-header__left">
            <h1 class="uta-page-title" style="font-size: 2rem;">
                <i class="bi bi-hand-wave-fill text-warning"></i> ¡Bienvenido!
            </h1>
            <p class="uta-page-subtitle" style="font-size: 1rem; margin-top: 0.3rem;">
                Resumen de tu jornada: <strong style="text-transform: capitalize;">@DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new CultureInfo("es-ES"))</strong>
            </p>
        </div>
        <div class="uta-page-header__right">
            <button class="uta-btn uta-btn--primary uta-btn--lg" @onclick='() => NavManager.NavigateTo("/ventas")'>
                <i class="bi bi-cart-plus"></i> &nbsp;Iniciar Nueva Venta
            </button>
        </div>
    </div>

    <div class="uta-dashboard-grid">
        <div class="uta-kpi-card">
            <div class="uta-kpi-card__icon" style="background-color: #fdf5f7; color: #6B1A33;">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div class="uta-kpi-card__info">
                <span class="uta-kpi-card__label">Ventas del Día</span>
                <span class="uta-kpi-card__value">$ 450.25</span>
            </div>
        </div>

        <div class="uta-kpi-card">
            <div class="uta-kpi-card__icon" style="background-color: #f0fdf4; color: #16a34a;">
                <i class="bi bi-receipt"></i>
            </div>
            <div class="uta-kpi-card__info">
                <span class="uta-kpi-card__label">Facturas Emitidas</span>
                <span class="uta-kpi-card__value">12</span>
            </div>
        </div>

        <div class="uta-kpi-card">
            <div class="uta-kpi-card__icon" style="background-color: #eff6ff; color: #2563eb;">
                <i class="bi bi-box-seam"></i>
            </div>
            <div class="uta-kpi-card__info">
                <span class="uta-kpi-card__label">Productos en Stock</span>
                <span class="uta-kpi-card__value">845</span>
            </div>
        </div>

        <div class="uta-kpi-card">
            <div class="uta-kpi-card__icon" style="background-color: #fdf4ff; color: #c026d3;">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="uta-kpi-card__info">
                <span class="uta-kpi-card__label">Clientes Registrados</span>
                <span class="uta-kpi-card__value">156</span>
            </div>
        </div>
    </div>

    <div class="uta-card mt-4">
        <div class="uta-card__header">
            <span class="uta-card__header-icon"><i class="bi bi-lightning-charge-fill text-warning"></i></span> 
            Accesos Rápidos
        </div>
        <div class="uta-card__body">
            <div class="uta-quick-actions">
                <button class="uta-action-box" @onclick='() => NavManager.NavigateTo("/ventas")'>
                    <div class="uta-action-box__icon"><i class="bi bi-cart3"></i></div>
                    <div class="uta-action-box__title">Punto de Venta</div>
                    <div class="uta-action-box__desc">Facturar productos a clientes</div>
                </button>

                <button class="uta-action-box" @onclick='() => NavManager.NavigateTo("/facturas")'>
                    <div class="uta-action-box__icon"><i class="bi bi-journal-text"></i></div>
                    <div class="uta-action-box__title">Historial de Facturas</div>
                    <div class="uta-action-box__desc">Consultar e imprimir comprobantes</div>
                </button>

                <button class="uta-action-box uta-action-box--disabled" title="Módulo en construcción">
                    <div class="uta-action-box__icon"><i class="bi bi-boxes"></i></div>
                    <div class="uta-action-box__title">Inventario</div>
                    <div class="uta-action-box__desc">Gestionar catálogo (Próximamente)</div>
                </button>
            </div>
        </div>
    </div>
</div>

@inherits LayoutComponentBase
@using System.Timers
@implements IDisposable

<div class="page uta-layout">
    <div class="sidebar uta-sidebar">
        <NavMenu />
    </div>

    <main class="uta-main">
        <header class="uta-top-bar">
            <div class="uta-top-bar__left">
                <div class="uta-status-pill" title="Conexión estable con el servidor">
                    <span class="uta-status-dot uta-status-dot--pulse"></span>
                    <span class="uta-status-text">Sistema En Línea</span>
                </div>
            </div>

            <div class="uta-top-bar__right">
                <div class="uta-clock-pill">
                    <i class="bi bi-clock text-primary"></i>
                    <span class="uta-clock-time">@_currentTime</span>
                </div>

                <button class="uta-icon-btn uta-notification-btn" title="Notificaciones">
                    <i class="bi bi-bell"></i>
                    <span class="uta-notification-badge">3</span>
                </button>

                <div class="uta-divider-vertical"></div>

                <div class="uta-user-menu">
                    <div class="uta-user-avatar">
                        UD
                    </div>
                    <div class="uta-user-info">
                        <span class="uta-user-name">Usuario Demo</span>
                        <span class="uta-user-role">Administrador</span>
                    </div>
                    <i class="bi bi-chevron-down uta-user-chevron"></i>
                </div>
            </div>
        </header>

        <article class="uta-content">
            @Body
        </article>
    </main>
</div>



@code {
    private string _currentTime = DateTime.Now.ToString("HH:mm:ss");
    private Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new Timer(1000);
        _timer.Elapsed += UpdateClock;
        _timer.AutoReset = true;
        _timer.Enabled = true;
    }

    private void UpdateClock(object? sender, ElapsedEventArgs e)
    {
        _currentTime = DateTime.Now.ToString("HH:mm:ss");
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
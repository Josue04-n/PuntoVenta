using Application.Interfaces.Repositories;
using Domain.Entities;
using Infrastructure.Data;
using Microsoft.EntityFrameworkCore;

namespace Infrastructure.Repositories;

public class CustomerRepository : ICustomerRepository
{
    private readonly AppDbContext _context;

    public CustomerRepository(AppDbContext context)
    {
        _context = context;
    }

    public async Task<IEnumerable<Customer>> SearchAsync(string term, string searchBy)
    {
        if (string.IsNullOrWhiteSpace(term))
            return Enumerable.Empty<Customer>();

        term = term.Trim().ToLower();
        searchBy = searchBy?.Trim().ToLower() ?? "cedula";

        if (searchBy == "id" || searchBy == "cedula")
        {
            var query = _context.Customers.AsNoTracking().Where(c => c.IDCard == term);

            if (int.TryParse(term, out int idSearch))
            {
                query = _context.Customers.AsNoTracking().Where(c => c.Id == idSearch || c.IDCard == term);
            }

            return await query.Take(1).ToListAsync();
        }

        return await _context.Customers
            .AsNoTracking()
            .Where(c =>
                c.Name.ToLower().Contains(term) ||
                c.LastName.ToLower().Contains(term))
            .Take(15)
            .ToListAsync();
    }
}

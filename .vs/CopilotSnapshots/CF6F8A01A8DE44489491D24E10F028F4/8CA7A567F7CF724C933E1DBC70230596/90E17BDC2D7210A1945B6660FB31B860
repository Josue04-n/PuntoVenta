        {
            var itemARemover = _carrito.FirstOrDefault(c => c.Producto.Id == error.IdProducto);
            if (itemARemover != null)
            {
                _carrito.Remove(itemARemover);
            }
        }
    }



    private async Task FinalizarVenta()
{
    // 1. Validación de Pre-condiciones en la UI (UX Preventiva)
    if (_clienteSeleccionado == null)
    {
        await MostrarNotificacion("Debe seleccionar un cliente antes de procesar la venta.", true);
        return;
    }

    foreach (var item in _carrito)
    {
        if (item.Cantidad > item.Producto.Stock)
        {
            await MostrarNotificacion($"Stock insuficiente para '{item.Producto.Name}'. Disponible: {item.Producto.Stock}.", true);
            return; 
        }
    }

    // 2. Preparación del Request (Capa de Aplicación - DTO)[cite: 2]
    var solicitudVenta = new CreateSaleRequest
    {
        CustomerId = _clienteSeleccionado.Id,
        Details = _carrito.Select(item => new CreateSaleDetailRequest 
        { 
            ProductId = item.Producto.Id, 
            Amount = item.Cantidad 
        }).ToList()
    };

    // 3. Ejecución Asíncrona (Prioridad Rendimiento)
    try 
    {
        var respuestaHttp = await ApiService.CreateSaleAsync(solicitudVenta);

        if (respuestaHttp.IsSuccessStatusCode)
        {
            // Procesamiento de respuesta exitosa (Deserialización segura)
            var contenidoJson = await respuestaHttp.Content.ReadAsStringAsync();
            using var documentoJson = System.Text.Json.JsonDocument.Parse(contenidoJson);

            if (documentoJson.RootElement.TryGetProperty("invoiceNumber", out var propiedadFactura))
            {
                _numeroFactura = propiedadFactura.GetString() ?? "AUTORIZADA";
            }

            // Refrescar el catálogo local para reflejar el nuevo stock
            var productosActualizados = await ApiService.GetAllProductsAsync();
            _catalogoCompleto = productosActualizados.Select(p => new ProductoUI 
            { 
                Id = p.Id, 
                Name = p.Name, 
                UnitPrice = p.UnitPrice, 
                Stock = p.Stock, 
                CantidadTemporal = 1 
            }).ToList();

            await MostrarNotificacion("¡Venta procesada y stock actualizado exitosamente!");
            _ventaCompletada = true;
            StateHasChanged();
        }
        else if (respuestaHttp.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            var contenidoJson = await respuestaHttp.Content.ReadAsStringAsync();
            var jsonDoc = System.Text.Json.JsonDocument.Parse(contenidoJson);
            var tipoError = jsonDoc.RootElement.TryGetProperty("type", out var t) ? t.GetString() : "BulkStock";

            if (tipoError == "BulkStock")
            {
                var errorResponse = System.Text.Json.JsonSerializer.Deserialize<BulkStockErrorResponse>(contenidoJson, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (errorResponse != null && errorResponse.Errors.Any())
                {
                    var htmlMessage = "<ul>";
                    foreach (var error in errorResponse.Errors)
                    {
                        htmlMessage += $"<li><strong>{error.NombreProducto}</strong>: Solicitaste {error.CantidadSolicitada}, pero solo hay {error.StockDisponible} en inventario.</li>";
                    }
                    htmlMessage += "</ul>";

                    await JS.InvokeVoidAsync("Swal.fire", new
                    {
                        title = "Ajuste Automático de Factura",
                        html = htmlMessage,
                        icon = "warning",
                        confirmButtonText = "Entendido, continuar con la venta",
                        buttonsStyling = false, // Deshabilitamos estilos por defecto de Swal para usar los nuestros
                        customClass = new {
                            popup = "uta-card uta-card--modal", // Nuestra clase de tarjeta
                            title = "uta-modal-title",
                            confirmButton = "uta-btn uta-btn--primary uta-btn--lg" // Nuestro botón vinotinto
                        },
                        showClass = new {
                            popup = "animate__animated animate__fadeInUp" // Animación fluida
                    }
                    });

                    RemoveOutOfStockProducts(errorResponse.Errors);
                    StateHasChanged();
                }
            }
            else if (tipoError == "ProductDeleted")
            {
                var errorResponse = System.Text.Json.JsonSerializer.Deserialize<ProductDeletedErrorResponse>(contenidoJson, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (errorResponse != null && errorResponse.DeletedProducts.Any())
                {
                    var htmlMessage = "<ul>";
                    foreach (var prod in errorResponse.DeletedProducts)
                    {
                        htmlMessage += $"<li>Producto <strong>{prod.ProductName}</strong> (ID: {prod.ProductId}) ya no está disponible.</li>";
                    }
                    htmlMessage += "</ul>";

                    await JS.InvokeVoidAsync("Swal.fire", new
                    {
                        icon = "error",
                        title = "Productos no disponibles",
                        html = htmlMessage,
                        confirmButtonText = "Entendido",
                        buttonsStyling = false,
                        customClass = new {
                            popup = "uta-card uta-card--modal", 
                            title = "uta-modal-title",
                            confirmButton = "uta-btn uta-btn--primary uta-btn--lg" 
                        },
                        showClass = new {
                            popup = "animate__animated animate__fadeInUp" 
                        }
                    });

                    foreach (var prod in errorResponse.DeletedProducts)
                    {
                        var item = _carrito.FirstOrDefault(c => c.Producto.Id == prod.ProductId);
                        if (item != null) _carrito.Remove(item);
                    }
                    StateHasChanged();
                }
            }
            else
            {
                await MostrarNotificacion($"Error: {contenidoJson}", true);
            }
        }
        else
        {
            var errorServidor = await respuestaHttp.Content.ReadAsStringAsync();
            await MostrarNotificacion($"Error inesperado en el servidor: {errorServidor}", true);
        }
    }
    catch (Exception ex)
    {
        // Fallo técnico de infraestructura (DIP)[cite: 1]
        await MostrarNotificacion("Error crítico de comunicación con el servidor.", true);
        Console.WriteLine($"Error técnico: {ex.Message}");
    }
}
    
    private void VerFactura()
    {
        NavManager.NavigateTo($"/facturas?numeroFactura={_numeroFactura}");
    }
    
    private void NuevaVenta()
    {
        _carrito.Clear(); _clienteSeleccionado = null; _ventaCompletada = false; _numeroFactura = "BORRADOR";
    }

@code {
    private CustomerModel? _clienteSeleccionado;
    private List<CarritoItem> _carrito = new();
    private string _mensajeAlerta = "";
    private bool _esError = false;
    private bool _ventaCompletada = false;
    private string _numeroFactura = "BORRADOR";
    
    private string _criterioBusquedaCliente = "cedula";
    private string _criterioBusquedaProducto = "name";

    private int _itemsPorPagina = 5;

    private int _paginaActualCliente = 1;
    private int TotalPaginasClientes => (int)Math.Ceiling(_resultadosClientes.Count / (double)_itemsPorPagina);
    private IEnumerable<CustomerModel> ClientesPaginados => _resultadosClientes.Skip((_paginaActualCliente - 1) * _itemsPorPagina).Take(_itemsPorPagina);
    
    private void PaginaAnteriorCliente() { if (_paginaActualCliente > 1) _paginaActualCliente--; }
    private void PaginaSiguienteCliente() { if (_paginaActualCliente < TotalPaginasClientes) _paginaActualCliente++; }

    private int _paginaActualProducto = 1;
    private int TotalPaginasProductos => (int)Math.Ceiling(_resultadosProductos.Count / (double)_itemsPorPagina);
    private IEnumerable<ProductoUI> ProductosPaginados => _resultadosProductos.Skip((_paginaActualProducto - 1) * _itemsPorPagina).Take(_itemsPorPagina);

    private void PaginaAnteriorProducto() { if (_paginaActualProducto > 1) _paginaActualProducto--; }
    private void PaginaSiguienteProducto() { if (_paginaActualProducto < TotalPaginasProductos) _paginaActualProducto++; }

    private void CambioCriterioCliente(ChangeEventArgs e)
    {
        _criterioBusquedaCliente = e.Value?.ToString() ?? "cedula";
        _terminoCliente = "";
        _resultadosClientes.Clear();
        _paginaActualCliente = 1;
    }

    private void CambioCriterioProducto(ChangeEventArgs e)
    {
        _criterioBusquedaProducto = e.Value?.ToString() ?? "name";
        _terminoProducto = "";
        _resultadosProductos.Clear();
        _paginaActualProducto = 1;
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        _mensajeAlerta = mensaje; _esError = esError;
        StateHasChanged(); await Task.Delay(3000);
        _mensajeAlerta = ""; StateHasChanged();
    }

    private async Task ActualizarCantidadCart(CarritoItem item, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int nuevaCantidad))
        {
            if (nuevaCantidad <= 0)
            {
                item.Cantidad = 1;
                await MostrarNotificacion("La cantidad mínima es 1. Use el botón '✕' para eliminar.", true);
            }
            else if (nuevaCantidad > item.Producto.Stock)
            {
                item.Cantidad = item.Producto.Stock;
                await MostrarNotificacion($"Stock insuficiente. Solo hay {item.Producto.Stock} disponibles.", true);
            }
            else
            {
                item.Cantidad = nuevaCantidad;
            }
        }
        else
        {
            item.Cantidad = 1; 
        }
    }

    public class CarritoItem
    {
        public ProductModel Producto { get; set; } = null!;
        public int Cantidad { get; set; }
        public decimal Subtotal => Producto.UnitPrice * Cantidad;
    }

    public class ProductoUI : ProductModel
    {
        public int CantidadTemporal { get; set; } = 1;
    }

    private bool _mostrarModalCliente = false;
    private string _terminoCliente = "";
    private List<CustomerModel> _resultadosClientes = new();
    
    private void AbrirModalCliente() { _mostrarModalCliente = true; _resultadosClientes.Clear(); _terminoCliente = ""; _paginaActualCliente = 1; }
    private void CerrarModalCliente() => _mostrarModalCliente = false;
    private async Task PresionoEnterCliente(KeyboardEventArgs e) { if (e.Key == "Enter") await BuscarClientesEnAPI(); }
    
    private async Task BuscarClientesEnAPI()
    {
        if (string.IsNullOrWhiteSpace(_terminoCliente)) return;
        _resultadosClientes = await ApiService.SearchCustomersAsync(_terminoCliente, _criterioBusquedaCliente);
        _paginaActualCliente = 1; 
    }
    
    private void SeleccionarCliente(CustomerModel cliente)
    {
        _clienteSeleccionado = cliente;
        CerrarModalCliente();
    }

    private bool _mostrarModalProducto = false;
    private string _terminoProducto = "";
    private List<ProductoUI> _resultadosProductos = new();
    
    private void AbrirModalProducto() { _mostrarModalProducto = true; _resultadosProductos.Clear(); _terminoProducto = ""; _paginaActualProducto = 1; }
    private void CerrarModalProducto() => _mostrarModalProducto = false;
    private async Task PresionoEnterProducto(KeyboardEventArgs e) { if (e.Key == "Enter") await BuscarProductosEnAPI(); }
    
    private async Task BuscarProductosEnAPI()
    {
        if (string.IsNullOrWhiteSpace(_terminoProducto)) return;
        var res = await ApiService.SearchProductsAsync(_terminoProducto, _criterioBusquedaProducto);
        _resultadosProductos = res.Select(p => new ProductoUI { Id = p.Id, Name = p.Name, UnitPrice = p.UnitPrice, Stock = p.Stock, CantidadTemporal = 1 }).ToList();
        _paginaActualProducto = 1; 
    }

    private async Task AgregarProducto(ProductoUI prod)
    {
        if (prod.CantidadTemporal > prod.Stock) { await MostrarNotificacion($"Solo hay {prod.Stock} en stock.", true); return; }
        var itemExistente = _carrito.FirstOrDefault(c => c.Producto.Id == prod.Id);
        if (itemExistente != null)
        {
            if (itemExistente.Cantidad + prod.CantidadTemporal > prod.Stock) { await MostrarNotificacion("Excede stock.", true); return; }
            itemExistente.Cantidad += prod.CantidadTemporal;
        }
        else
        {
            _carrito.Add(new CarritoItem { Producto = new ProductModel { Id = prod.Id, Name = prod.Name, UnitPrice = prod.UnitPrice, Stock = prod.Stock }, Cantidad = prod.CantidadTemporal });
        }
        await MostrarNotificacion($"{prod.Name} añadido.");
        prod.CantidadTemporal = 1;
    }

    private void EliminarDelCarrito(CarritoItem item) => _carrito.Remove(item);

    private decimal SubtotalGlobal => _carrito.Sum(i => i.Subtotal);
    private decimal IvaGlobal => SubtotalGlobal * 0.15m;
    private decimal TotalFinal => SubtotalGlobal + IvaGlobal;
    private bool PuedeFinalizar => _clienteSeleccionado != null && _carrito.Any();

    // =============== SOLUCIÓN BLINDADA PARA LEER EL JSON ===============
    private async Task FinalizarVenta()
    {
        var request = new CreateSaleRequest
        {
            CustomerId = _clienteSeleccionado!.Id,
            Details = _carrito.Select(i => new CreateSaleDetailRequest { ProductId = i.Producto.Id, Amount = i.Cantidad }).ToList()
        };

        var response = await ApiService.CreateSaleAsync(request);
        if (response.IsSuccessStatusCode)
        {
            // Leemos como texto puro para evitar que el deserializador explote por los Value Objects
            var jsonString = await response.Content.ReadAsStringAsync();
            
            try
            {
                // Extraemos únicamente el invoiceNumber dinámicamente
                using var document = System.Text.Json.JsonDocument.Parse(jsonString);
                if (document.RootElement.TryGetProperty("invoiceNumber", out var invoiceProp))
                {
                    _numeroFactura = invoiceProp.GetString() ?? "DESCONOCIDO";
                }
                else
                {
                    _numeroFactura = "AUTORIZADA";
                }
            }
            catch
            {
                _numeroFactura = "AUTORIZADA";
            }
            
            await MostrarNotificacion("¡Venta procesada exitosamente!");
            _ventaCompletada = true;
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            await MostrarNotificacion($"Error: {error}", true);
        }
    }
    
    private void VerFactura()
    {
        NavManager.NavigateTo($"/facturas?numeroFactura={_numeroFactura}");
    }
    
    private void NuevaVenta()
    {
        _carrito.Clear(); _clienteSeleccionado = null; _ventaCompletada = false; _numeroFactura = "BORRADOR";
    }

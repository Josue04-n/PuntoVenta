    private async Task FinalizarVenta()
    {
        if (_clienteSeleccionado == null)
        {
            await MostrarNotificacion("Debe seleccionar un cliente antes de procesar la venta.", true);
            return;
        }

        foreach (var item in _carrito)
        {
            if (item.Amount > item.Product.Stock)
            {
                await MostrarNotificacion($"Stock insuficiente para '{item.Product.Name}'. Disponible: {item.Product.Stock}.", true);
                return; 
            }
        }

        var solicitudVenta = new Application.DTOs.CreateSaleRequest
        {
            CustomerId = _clienteSeleccionado.Id,
            Details = _carrito.Select(item => new CreateRequestDetail
            {
                ProductId = item.Product.Id,
                Amount = item.Amount
            }).ToList()
        };

        try 
        {
            var respuestaHttp = await ApiService.CreateSaleAsync(solicitudVenta);

            if (respuestaHttp.IsSuccessStatusCode)
            {
                var contenidoJson = await respuestaHttp.Content.ReadAsStringAsync();
                using var documentoJson = System.Text.Json.JsonDocument.Parse(contenidoJson);

                if (documentoJson.RootElement.TryGetProperty("invoiceNumber", out var propiedadFactura))
                {
                    _numeroFactura = propiedadFactura.GetString() ?? "AUTORIZADA";
                }

                await MostrarNotificacion("¡Venta procesada y stock actualizado exitosamente!");
                _ventaCompletada = true;
                StateHasChanged();
            }
            else
            {
                var contenidoJson = await respuestaHttp.Content.ReadAsStringAsync();
                bool errorManejado = false;

                try 
                {
                    var jsonDoc = System.Text.Json.JsonDocument.Parse(contenidoJson);
                    if (jsonDoc.RootElement.TryGetProperty("type", out var t))
                    {
                        var tipoError = t.GetString();

                        if (tipoError == "BulkStock")
                        {
                            var options = new System.Text.Json.JsonSerializerOptions 
                            { 
                                PropertyNameCaseInsensitive = true,
                                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
                            };
                            var errorResponse = System.Text.Json.JsonSerializer.Deserialize<BulkStockErrorResponse>(contenidoJson, options);
                            if (errorResponse != null && errorResponse.Errors != null && errorResponse.Errors.Any())
                            {
                                var htmlMessage = "<div class='uta-swal-list-container'><ul class='uta-swal-list'>";
                                foreach (var error in errorResponse.Errors)
                                {
                                    htmlMessage += $"<li><i class='bi bi-dot'></i> <strong>{error.NombreProducto}</strong>: Solicitaste {error.CantidadSolicitada}, pero solo hay {error.StockDisponible} en stock.</li>";
                                }
                                htmlMessage += "</ul></div>";

                                await JS.InvokeVoidAsync("Swal.fire", new
                                {
                                    icon = "error",
                                    title = "Ajuste de Inventario",
                                    html = htmlMessage,
                                    confirmButtonText = "Entendido",
                                    buttonsStyling = false,
                                    customClass = new {
                                        container = "uta-swal-container",
                                        popup = "uta-swal-popup",
                                        title = "uta-swal-title",
                                        htmlContainer = "uta-swal-html",
                                        confirmButton = "uta-btn uta-btn--primary uta-btn--lg" 
                                    },
                                    showClass = new {
                                        popup = "animate__animated animate__fadeInUp" 
                                    }
                                });

                                RemoveOutOfStockProducts(errorResponse.Errors);
                                errorManejado = true;
                            }
                        }
                        else if (tipoError == "ProductDeleted")
                        {
                            var options = new System.Text.Json.JsonSerializerOptions 
                            { 
                                PropertyNameCaseInsensitive = true,
                                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
                            };
                            var errorResponse = System.Text.Json.JsonSerializer.Deserialize<ProductDeletedErrorResponse>(contenidoJson, options);
                            if (errorResponse != null && errorResponse.DeletedProducts != null && errorResponse.DeletedProducts.Any())
                            {
                                var htmlMessage = "<div class='uta-swal-list-container'><ul class='uta-swal-list'>";
                                foreach (var prod in errorResponse.DeletedProducts)
                                {
                                    htmlMessage += $"<li><i class='bi bi-dot'></i> Producto <strong>{prod.ProductName}</strong> (ID: {prod.ProductId}) ya no está disponible.</li>";
                                }
                                htmlMessage += "</ul></div>";

                                await JS.InvokeVoidAsync("Swal.fire", new
                                {
                                    icon = "error",
                                    title = "Productos No Disponibles",
                                    html = htmlMessage,
                                    confirmButtonText = "Entendido",
                                    buttonsStyling = false,
                                    customClass = new {
                                        container = "uta-swal-container",
                                        popup = "uta-swal-popup",
                                        title = "uta-swal-title",
                                        htmlContainer = "uta-swal-html",
                                        confirmButton = "uta-btn uta-btn--primary uta-btn--lg" 
                                    },
                                    showClass = new {
                                        popup = "animate__animated animate__fadeInUp" 
                                    }
                                });

                                foreach (var prod in errorResponse.DeletedProducts)
                                {
                                    var item = _carrito.FirstOrDefault(c => c.Product.Id == prod.ProductId);
                                    if (item != null) _carrito.Remove(item);
                                }
                                errorManejado = true;
                            }
                        }
                    }
                }
                catch (Exception exDeserialize)
                {
                    Console.WriteLine($"Error parseando JSON: {exDeserialize.Message}");
                }

                if (!errorManejado)
                {
                    await MostrarNotificacion($"Error inesperado en el servidor: {contenidoJson}", true);
                }
                
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await MostrarNotificacion("Error crítico de comunicación con el servidor.", true);
            Console.WriteLine($"Error técnico: {ex.Message}");
        }
    }
    

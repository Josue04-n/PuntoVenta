    private List<int> GetPaginasVisibles(int paginaActual, int totalPaginas)
    {
        var paginas = new List<int>();

        if (totalPaginas <= 7)
        {
            for (int i = 1; i <= totalPaginas; i++) paginas.Add(i);
            return paginas;
        }

        paginas.Add(1);

        if (paginaActual > 3) paginas.Add(-1);

        int inicio = Math.Max(2, paginaActual - 1);
        int fin = Math.Min(totalPaginas - 1, paginaActual + 1);

        for (int i = inicio; i <= fin; i++) paginas.Add(i);

        if (paginaActual < totalPaginas - 2) paginas.Add(-1);
        paginas.Add(totalPaginas);
        return paginas.Distinct().ToList();
    }

